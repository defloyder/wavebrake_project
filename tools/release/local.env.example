# Copy to tools/release/local.env (not in git) and fix the paths for this machine.
# Everything else the release script needs is in the repo.
FLUTTER_BIN=/c/src/flutter/bin
ANDROID_HOME=/c/dev-tools/android-sdk
# Used by wavebreak-mobile/native/hysteria_bridge/build_aar.sh
JAVA_HOME=/c/dev-tools/jdk-17.0.20.1+1
ANDROID_NDK_HOME=/c/dev-tools/android-sdk/ndk/28.2.13676358
export JAVA_HOME ANDROID_HOME ANDROID_NDK_HOME
# Your own SSH key with access to both servers (the owner adds its .pub there)
SSH_KEY=$HOME/.ssh/wavebreak_pilot
# Inno Setup 6
ISCC="$LOCALAPPDATA/Programs/Inno Setup 6/ISCC.exe"
