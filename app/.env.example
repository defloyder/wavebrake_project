APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public legal details
LEGAL_EMAIL=auralith_ru@outlook.com
LEGAL_POSTAL_ADDRESS="Укажите полный адрес для корреспонденции и претензий"
LEGAL_SUPPORT_HOURS="Ежедневно с 10:00 до 19:00 по московскому времени"

# Node Monitoring API (set when API is ready, then flip STUB_MODE=false in NodeMonitorService)
MONITOR_API_URL=
MONITOR_API_TOKEN=

# Freekassa Payment Gateway
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET1=
FREEKASSA_SECRET2=

# Auralith Core API (Python/FastAPI)
CORE_API_URL=https://your-core-api.com
CORE_ADMIN_KEY=

# Core DB sync for orders:sync
CORE_DB_CONNECTION=core_mysql
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=3306
CORE_DB_DATABASE=
CORE_DB_USERNAME=
CORE_DB_PASSWORD=
CORE_DB_SOCKET=
CORE_DB_CHARSET=utf8mb4
CORE_DB_COLLATION=utf8mb4_unicode_ci
CORE_DB_SSL_CA=
CORE_ORDERS_TABLE=fk_orders
CORE_USERS_TABLE=users

# Admin panel security
ADMIN_PATH_PREFIX=admin

# CloudPayments
CP_PUBLIC_ID=pk_your_public_id_here
CP_API_SECRET=your_api_secret_here
CP_RECEIPT_ENABLED=true
CP_RECEIPT_TAXATION_SYSTEM=0
CP_RECEIPT_VAT=0
CP_RECEIPT_METHOD=0
CP_RECEIPT_OBJECT=4
CP_RECEIPT_CALCULATION_PLACE="${APP_URL}"

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@auralith.ru
