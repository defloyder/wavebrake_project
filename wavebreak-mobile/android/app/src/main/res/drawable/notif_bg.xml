<?xml version="1.0" encoding="utf-8"?>
<!-- A diagonal midnight-to-deep-ocean gradient standing in for the app's
     animated wave background — a real animated SVG isn't renderable inside
     a RemoteViews notification, so this is the closest static echo of it:
     same two colors, same direction the in-app ocean backdrop uses.
     The angle must be a multiple of 45: Android 10 throws on anything
     else while drawing the notification, which crashes SystemUI (the
     shade went dark and dropped to the lock screen — field report,
     Redmi Note 9 Pro, Android 10). 115 was used before. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <gradient
        android:angle="135"
        android:startColor="@color/wb_midnight"
        android:endColor="@color/wb_deep_ocean"
        android:type="linear" />
</shape>
