server {
    listen 80;
    server_name www.${WAVEBREAK_DOMAIN};

    location / {
        proxy_pass http://wavebreak-web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 80;
    server_name admin.${WAVEBREAK_DOMAIN};

    location / {
        proxy_pass http://wavebreak-admin:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 80;
    server_name api.${WAVEBREAK_DOMAIN};

    location / {
        proxy_pass http://wavebreak-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
