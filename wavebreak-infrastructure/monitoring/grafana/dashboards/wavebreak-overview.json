{
  "title": "WAVEBREAK Overview",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(wavebreak_http_requests_total[5m])) by (status)", "legendFormat": "{{status}}"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP Latency p95",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(wavebreak_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}]
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ Failures",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "increase(wavebreak_rabbitmq_failures_total[10m])", "legendFormat": "{{operation}}"}]
    }
  ]
}
